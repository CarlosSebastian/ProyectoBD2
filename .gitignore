build/
# Todo lo que el motor genera dentro de data/ queda fuera del repositorio.
# Se ignora la carpeta ENTERA y se rescata solo el .gitkeep: con patrones de
# un nivel (data/*.dat) se colaban los binarios que los tests dejan en
# subcarpetas como data/test_sql_estrictos/.
data/*
!data/.gitkeep

# Excepcion: los datos del Experimento 7. Son histogramas BoVW y vectores
# densos derivados del dataset Natural Images, y se versionan a proposito para
# que el experimento se pueda reproducir sin bajar 350 MB de imagenes de
# Kaggle ni reejecutar 8 minutos de SIFT. Pesan 39 MB entre los dos.
!data/bovw_palabras.csv
!data/bovw_emb.csv
!data/bovw_consultas.txt
!data/bovw_tiempos.txt
*.o
*.exe
.vscode/

informe/*.aux
informe/*.log
informe/*.out
informe/*.fls
informe/*.fdb_latexmk
informe/figuras/*.png

# Las figuras en PDF y el informe compilado SI se versionan: el enunciado
# pide el PDF en el repositorio.

# El informe y el script de graficas son entregables aparte, NO van al repo.
# Ademas, al estar ignorados, 'git clean -fd' ya no los borra.
informe/
benchmarks/graficas.py

# Aplicacion de IA (RAG): el corpus y los embeddings son datos generados.
ai/corpus/*
!ai/corpus/.gitkeep
!ai/corpus/muestra_100.jsonl
ai/cache/*
!ai/cache/.gitkeep
__pycache__/
graphify-out/

# Muestra minima del dataset de imagenes: SOLO las que usan los cuatro
# botones de demostracion del visor multimedia. El dataset completo
# (natural_images, 8 clases, 6 899 archivos) son 186 MB y no se versiona;
# sin estas, quien clone el repo ve el panel 6 con los recuadros vacios.
!data/natural_images/
data/natural_images/*
!data/natural_images/*/
data/natural_images/*/*
